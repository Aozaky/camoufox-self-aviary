# Copy to .env and edit before first start.
# Viewer/API password for the KasmVNC desktop. Required, >= 12 chars.
CAMOUFOX_VIEWER_PASSWORD=change-me-to-a-long-random-string
VNC_RESOLUTION=1440x900
# Loopback by default. If you put a TLS proxy in front, set the public URL:
# PUBLIC_BASE_URL=https://camoufox.example.com
PUBLIC_BASE_URL=http://127.0.0.1:19280
VIEWER_PORT=6901
GATEWAY_PORT=19280
COMPOSE_PROJECT_NAME=aviary
CONTAINER_NAME=aviary
